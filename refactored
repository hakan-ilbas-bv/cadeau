    /// <summary>
    /// Logging infrastructure
    /// </summary>
    public static class Logger
    {
        private static readonly object _lock = new object();
        
        public static void Log(string message, LogLevel level = LogLevel.Info)
        {
            if (!Config.ENABLE_LOGGING) return;
            
            string logEntry = $"{DateTime.Now:yyyy-MM-dd HH:mm:ss} [{level}] {message}";
            
            try
            {
                lock (_lock)
                {
                    File.AppendAllText(Config.LOG_FILE_PATH, logEntry + Environment.NewLine);
                }
                
                // Also output to console for immediate feedback
                Console.WriteLine(logEntry);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ERROR] Failed to log message: {ex.Message}");
            }
        }
        
        public static void LogError(string message, Exception ex = null)
        {
            string errorMessage = message;
            if (ex != null)
            {
                errorMessage += $" | Exception: {ex.GetType().Name}: {ex.Message}";
            }
            Log(errorMessage, LogLevel.Error);
        }
        
        public static void LogWarning(string message)
        {
            Log(message, LogLevel.Warning);
        }
        
        public static void LogInfo(string message)
        {
            Log(message, LogLevel.Info);
        }
    }

